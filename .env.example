# Copy to .env and fill in. NEVER commit .env with real keys.
# At least ONE LLM key is recommended for AI moment scoring.
# Without any key the pipeline still works with the heuristic scorer.

# --- LLM for moment scoring (pick one) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=
# OPENAI default: gpt-4o-mini | GEMINI default: gemini-2.0-flash

# --- Whisper (local transcription) ---
WHISPER_MODEL=base
WHISPER_DEVICE=auto
# auto = cuda if available else cpu

# --- Storage ---
DATA_DIR=./data

# --- Job limits ---
MAX_CLIPS=100

# --- yt-dlp ---
# Path to a cookies.txt (exported from your browser) if YouTube/Twitch
# blocks anonymous downloads with a 403. Leave empty normally.
YTDLP_COOKIES=

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# --- Worker ---
# If true, the API process also runs jobs inline (dev only, 1 job at a time).
RUN_WORKER_IN_API=false
